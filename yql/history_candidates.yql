USE kolmogorov;

PRAGMA yt.TemporaryCompressionCodec = "zstd_3";
PRAGMA yt.UseNativeYtTypes;

$train = "//home/bm/users/argus/mla/data/train_100m";
$validation = "//home/bm/users/argus/mla/data/val_clicks";
$test = "//home/bm/users/argus/mla/data/test_clicks";

-- Ограничиваем тяжёлую агрегацию только запросами, которые встретятся на
-- валидации или скрытом тесте. Клики и статистики при этом берём только из
-- train_100m, поэтому leakage между сплитами нет.
$target_query_rows = (
    SELECT SearchQuery AS search_query
    FROM $validation
    WHERE SearchQuery IS NOT NULL AND SearchQuery != ""

    UNION ALL

    SELECT SearchQuery AS search_query
    FROM $test
    WHERE SearchQuery IS NOT NULL AND SearchQuery != ""
);

$target_queries = (
    SELECT search_query
    FROM $target_query_rows
    GROUP BY search_query
);

$matched_clicks = (
    SELECT
        train.SearchQuery AS search_query,
        COALESCE(train.RegionID, 0) AS region_id,
        train.BannerID AS banner_id,
        COALESCE(train.SourceCost, 0) AS source_cost,
        COALESCE(train.ShowTime, 0ul) AS show_time
    FROM $train AS train
    INNER JOIN $target_queries AS targets
        ON train.SearchQuery == targets.search_query
    WHERE
        COALESCE(train.IsClick, 0) > 0
        AND train.BannerID IS NOT NULL
        AND train.SearchQuery IS NOT NULL
        AND train.SearchQuery != ""
);

$query_stats = (
    SELECT
        "query" AS key_type,
        search_query,
        0 AS region_id,
        banner_id,
        COUNT(*) AS click_count,
        SUM(source_cost) AS source_cost_sum,
        MAX(show_time) AS last_show_time
    FROM $matched_clicks
    GROUP BY
        search_query,
        banner_id
);

$query_region_stats = (
    SELECT
        "query_region" AS key_type,
        search_query,
        region_id,
        banner_id,
        COUNT(*) AS click_count,
        SUM(source_cost) AS source_cost_sum,
        MAX(show_time) AS last_show_time
    FROM $matched_clicks
    GROUP BY
        search_query,
        region_id,
        banner_id
);

$all_stats = (
    SELECT * FROM $query_stats
    UNION ALL
    SELECT * FROM $query_region_stats
);

$ranked = (
    SELECT
        key_type,
        search_query,
        region_id,
        banner_id,
        click_count,
        source_cost_sum,
        last_show_time,
        ROW_NUMBER() OVER (
            PARTITION BY key_type, search_query, region_id
            ORDER BY
                source_cost_sum DESC,
                click_count DESC,
                last_show_time DESC,
                banner_id
        ) AS candidate_rank
    FROM $all_stats
);

SELECT
    key_type,
    search_query,
    region_id,
    banner_id,
    click_count,
    source_cost_sum,
    last_show_time,
    candidate_rank
FROM $ranked
WHERE candidate_rank <= 200;
