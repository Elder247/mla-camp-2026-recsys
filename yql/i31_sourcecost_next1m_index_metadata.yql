USE kolmogorov;

PRAGMA yt.TemporaryCompressionCodec = "zstd_3";
PRAGMA yt.UseNativeYtTypes;

$index = "//home/bm/users/argus/mla/index";
$extension_ids = "//tmp/astrofimuk_mla_two_stage/i31_remaining_trainseen_banner_ids_20260810_0835";

SELECT
    index.BannerID AS BannerID,
    index.BannerText AS BannerText,
    index.BannerTitle AS BannerTitle,
    index.BannerURL AS BannerURL,
    index.CaesarModelID AS CaesarModelID,
    index.CaesarSkuID AS CaesarSkuID,
    index.ClientID AS ClientID,
    index.GroupExportID AS GroupExportID,
    index.OrderID AS OrderID,
    index.ProductPrice AS ProductPrice,
    index.SourceCost AS SourceCost
FROM $index AS index
INNER JOIN $extension_ids AS extension
    ON index.BannerID == extension.BannerID
ORDER BY
    COALESCE(index.SourceCost, 0.0) DESC,
    index.BannerID ASC
LIMIT 1000000;
